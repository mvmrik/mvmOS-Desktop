{
  "name": "mvmos-desktop",
  "productName": "mvmOS Desktop",
  "version": "0.4.3",
  "description": "Desktop client for managing and using your mvmOS installations.",
  "homepage": "https://mvmos.org",
  "desktopName": "mvmos-desktop.desktop",
  "author": "mvmrik",
  "license": "MIT",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.mvmrik.mvmosdesktop",
    "productName": "mvmOS Desktop",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "build/icon.*",
      "build/tray.png",
      "package.json"
    ],
    "linux": {
      "executableName": "mvmos-desktop",
      "syncDesktopName": true,
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "maintainer": "mvmrik"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
